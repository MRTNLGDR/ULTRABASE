# Copie apenas estas duas variáveis para cada aplicativo.
# Obtenha a chave real com 03-MOSTRAR-CREDENCIAIS.cmd.
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_A_CHAVE_PUBLICAVEL

# Nunca coloque SUPABASE_SECRET_KEY, SERVICE_ROLE_KEY ou POSTGRES_PASSWORD
# em frontends, aplicativos móveis ou qualquer código distribuído ao usuário.
